# Configuração do Banco de Dados (SQLite em dev, Postgres em prod)
DATABASE_URL="file:./dev.db"

# Autenticação (Chave secreta para assinatura dos tokens JWT)
# ATENÇÃO: Em produção, gere uma string aleatória forte com pelo menos 32 caracteres.
JWT_SECRET="gere-um-segredo-longo-e-aleatorio-para-producao-2026"

# Usuário Administrador Inicial para o Seed
# ATENÇÃO: NUNCA suba senhas reais para o repositório. Defina obrigatoriamente antes do seed.
ADMIN_EMAIL="admin@exemplo.com.br"
ADMIN_PASSWORD="TroqueEstaSenhaForte123!"
ADMIN_NAME="Administrador Inicial"

# Configuração da Aplicação
NEXT_PUBLIC_APP_NAME="Snack Fácil"
TZ="America/Sao_Paulo"
