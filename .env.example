# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA FINANCEIRO SNACK FÁCIL
# ==============================================================================
# Copie este arquivo para .env e preencha os valores conforme seu ambiente.
# NUNCA comite senhas, chaves ou connection strings no repositório.

# ------------------------------------------------------------------------------
# BANCO DE DADOS (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Conexão usada pela aplicação em tempo de execução.
# Deve usar o connection pooler (Supavisor) em modo TRANSACTION (porta 6543).
# Parâmetros recomendados para Prisma: ?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# DIRECT_URL:
# Conexão direta ou pelo pooler em modo SESSION (porta 5432).
# Usada EXCLUSIVAMENTE pelo Prisma Migrate (prisma migrate deploy) e scripts de migração/backup.
# Migrações e DDL não funcionam no modo transaction do pooler.
# ATENÇÃO A IPv6: Se seu host/VPS não suporta IPv6, utilize o host do pooler na porta 5432
# em vez do host direto db.[PROJECT_REF].supabase.co.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO (JWT)
# ------------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura dos tokens JWT de sessão.
# Gere uma string aleatória forte de pelo menos 32 caracteres (ex: openssl rand -base64 32).
JWT_SECRET="gere-um-segredo-longo-e-aleatorio-para-producao-2026"

# ------------------------------------------------------------------------------
# USUÁRIO ADMINISTRADOR INICIAL (Apenas para seeds de ambientes novos)
# ------------------------------------------------------------------------------
# Usado apenas ao rodar o seed em um banco do zero.
ADMIN_EMAIL="admin@snackfacil.com.br"
ADMIN_PASSWORD="TroqueEstaSenhaForte123!"
ADMIN_NAME="Sócio Snack Fácil"

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DA APLICAÇÃO & FUSO HORÁRIO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Snack Fácil"
TZ="America/Sao_Paulo"
